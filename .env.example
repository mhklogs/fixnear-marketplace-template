# Supabase project credentials.
# Copy this file to `.env` and fill in values from
# Supabase Dashboard > Project Settings > API.
# When left blank, the app runs in local "demo mode" (no network calls).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API key — required ONLY for the AI chat widget and trade autocomplete.
# Get one at https://aistudio.google.com/apikey
# When left blank, those features fall back to a local canned response engine,
# so the rest of the app still works.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Model used by the chat and autocomplete endpoints.
GEMINI_MODEL=gemini-2.0-flash

# Optional. Port for the local API server (`npm run dev`).
PORT=3001
